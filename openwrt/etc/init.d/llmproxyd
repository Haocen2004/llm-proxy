#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load dshp
	config_get enabled main enabled 1
	[ "$enabled" = "1" ] || return 0
	config_get listen main listen "127.0.0.1:19000"
	config_get upstream main upstream "http://127.0.0.1:9100"
	config_get upstream_host main upstream_host "localhost"
	[ -r /etc/dshp/llmproxyd.env ] || {
		logger -t llmproxyd "missing /etc/dshp/llmproxyd.env"
		return 1
	}
	. /etc/dshp/llmproxyd.env
	procd_open_instance
	procd_set_param command /usr/bin/llmproxyd \
		--config /etc/dshp/llmproxyd.toml \
		--listen "$listen" \
		--upstream "$upstream" \
		--upstream-host "$upstream_host"
	procd_set_param env \
		DSHP_PSK="$DSHP_PSK" \
		DSHP_WEBUI_TOKEN="$DSHP_WEBUI_TOKEN" \
		DSHP_STATS_FILE="$DSHP_STATS_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
