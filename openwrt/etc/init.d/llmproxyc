#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1

start_service() {
	config_load dshp
	config_get_bool enabled client enabled 0
	[ "$enabled" = "1" ] || return 0
	config_get listen client listen '0.0.0.0:8080'
	config_get server client server 'ws://127.0.0.1:19000'
	config_get upstream_host client upstream_host 'localhost'
	# 直连兜底（可选）：DSHP 链路不可用时改走这个上游前缀。
	#
	# **只写 `scheme://host[:port]`，不要带 `/v1`**：`fallback_url()` 是**纯前缀拼接**
	# （设计 §4.1 上游无关，不做任何路径改写）⇒ 带 `/v1` 会拼成 `/v1/v1/messages`。
	# 另外客户端不支持 TLS 上游（`enforce_http(true)`），所以这里必须是 `http://`。
	config_get upstream_fallback client upstream_fallback ''
	[ -r /etc/dshp/llmproxyd.env ] || return 1
	. /etc/dshp/llmproxyd.env
	procd_open_instance
	if [ -n "$upstream_fallback" ]; then
		procd_set_param command /usr/bin/llmproxyc --listen "$listen" --server "$server" --upstream-host "$upstream_host" --force-mode ws --keepalive-sec 30 --allow-lan --upstream-fallback "$upstream_fallback"
	else
		procd_set_param command /usr/bin/llmproxyc --listen "$listen" --server "$server" --upstream-host "$upstream_host" --force-mode ws --keepalive-sec 30 --allow-lan
	fi
	procd_set_param env DSHP_PSK="$DSHP_PSK" DSHP_ALLOW_LAN=1
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger dshp
}
